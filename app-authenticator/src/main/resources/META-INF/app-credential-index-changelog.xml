<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.16.xsd">

    <changeSet author="giuliano.mele@verdigado.com" id="app-auth-credential-index-1">

        <createTable tableName="APP_AUTH_CREDENTIAL_INDEX">
            <column name="CREDENTIAL_ID" type="VARCHAR(36)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_APP_AUTH_CREDENTIAL_INDEX"/>
            </column>
            <column name="REALM_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="USER_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="DEVICE_ID" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint columnNames="REALM_ID, DEVICE_ID" constraintName="UC_APP_AUTH_CRED_IDX_REALM_DEVICE" tableName="APP_AUTH_CREDENTIAL_INDEX"/>
        <createIndex indexName="IDX_APP_AUTH_CRED_IDX_REALM_DEVICE" tableName="APP_AUTH_CREDENTIAL_INDEX">
            <column name="REALM_ID"/>
            <column name="DEVICE_ID"/>
        </createIndex>
        <addForeignKeyConstraint baseColumnNames="REALM_ID" baseTableName="APP_AUTH_CREDENTIAL_INDEX" constraintName="FK_APP_AUTH_CRED_IDX_ON_REALM"
                                 onDelete="CASCADE" referencedColumnNames="ID" referencedTableName="REALM"/>
        <addForeignKeyConstraint baseColumnNames="USER_ID" baseTableName="APP_AUTH_CREDENTIAL_INDEX" constraintName="FK_APP_AUTH_CRED_IDX_ON_USER"
                                 onDelete="CASCADE" referencedColumnNames="ID" referencedTableName="USER_ENTITY"/>
        <addForeignKeyConstraint baseColumnNames="CREDENTIAL_ID" baseTableName="APP_AUTH_CREDENTIAL_INDEX" constraintName="FK_APP_AUTH_CRED_IDX_ON_CREDENTIAL"
                                 onDelete="CASCADE" referencedColumnNames="ID" referencedTableName="CREDENTIAL"/>
    </changeSet>

</databaseChangeLog>
