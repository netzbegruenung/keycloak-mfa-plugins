{
  "name": "Keycloak Core Development",
  "image": "mcr.microsoft.com/devcontainers/base:debian",

  "features": {
	"ghcr.io/devcontainers/features/github-cli:latest": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:latest": {},
    "ghcr.io/devcontainers/features/java:latest": {
      "version": "21",
      "installMaven": "true"
    },
    "ghcr.io/devcontainers/features/node:latest": {
      "version": "22",
      "pnpmVersion": "latest"
    }
  },

  "mounts": [
    "source=claude-code-data,target=/home/vscode/.claude,type=volume",
    "source=${localEnv:HOME}/.ssh/id_claude_signing,target=/home/vscode/.ssh/id_claude_signing,type=bind",
  	"source=${localEnv:HOME}/.config/gh,target=/home/vscode/.config/gh,type=bind"
  ],

  "containerEnv": {
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}",
	"GH_TOKEN": "${localEnv:GH_TOKEN}"
  },

  "postCreateCommand": "sudo chown -R --reference=\"$(npm -g config get prefix)/lib/node_modules\" \"$(npm -g config get prefix)/lib/node_modules/@anthropic-ai\" 2>/dev/null || true",

  "remoteUser": "vscode"
}
